# ==========================================================================
# Diamba Sagrada — variáveis de ambiente (copie para .env.local e preencha)
# ==========================================================================

# --- Público (exposto ao navegador) ---------------------------------------
# WhatsApp de contato — somente dígitos, com DDI 55. ⚠ PENDENTE (número novo).
NEXT_PUBLIC_WHATSAPP=5535999999999
# E-mail corporativo (compra após dia 15). ⚠ PENDENTE.
NEXT_PUBLIC_CONTACT_EMAIL=contato@diambasagrada.org.br
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/diambasagrada
# Link de loja em marketplace (opcional).
NEXT_PUBLIC_MERCADO_LIVRE=
# URL pública do site (usada para montar returnUrl/completionUrl do pagamento).
# Em produção, defina para o domínio real.
NEXT_PUBLIC_SITE_URL=

# --- Associação ------------------------------------------------------------
# Valor da taxa de associado em centavos. ⚠ PENDENTE (R$30 = 3000).
MEMBERSHIP_FEE_CENTS=3000

# --- Abacate Pay (pagamento) ----------------------------------------------
# ⚠ PENDENTE: a Jéssica vai criar a conta e enviar a chave.
ABACATE_API_KEY=
ABACATE_API_URL=https://api.abacatepay.com/v1
# Segredo para validar o webhook de confirmação de pagamento.
ABACATE_WEBHOOK_SECRET=

# --- Notificação por e-mail (envio das fichas) ----------------------------
# Provedor Resend (https://resend.com). Sem a chave, o envio só é logado.
RESEND_API_KEY=
RESEND_FROM=Diamba Sagrada <no-reply@diambasagrada.org.br>
# Para onde as fichas são enviadas (default = NEXT_PUBLIC_CONTACT_EMAIL).
NOTIFY_EMAIL=
